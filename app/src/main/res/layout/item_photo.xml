<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumbImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_photo_placeholder"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.RoundedThumb" />

    <View
        android:id="@+id/selectMask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#4D0E1620"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/thumbImage"
        app:layout_constraintEnd_toEndOf="@id/thumbImage"
        app:layout_constraintStart_toStartOf="@id/thumbImage"
        app:layout_constraintTop_toTopOf="@id/thumbImage" />

    <FrameLayout
        android:id="@+id/selectBadge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="6dp"
        android:background="@drawable/bg_select_ring"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/thumbImage"
        app:layout_constraintTop_toTopOf="@id/thumbImage">

        <com.workcamera.app.GlyphView
            android:id="@+id/selectCheckGlyph"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_item_scrim"
        app:layout_constraintBottom_toBottomOf="@id/thumbImage"
        app:layout_constraintEnd_toEndOf="@id/thumbImage"
        app:layout_constraintStart_toStartOf="@id/thumbImage" />

    <TextView
        android:id="@+id/itemLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="#CCFFFFFF"
        android:textSize="9sp"
        app:layout_constraintBottom_toTopOf="@id/itemTime"
        app:layout_constraintEnd_toEndOf="@id/thumbImage"
        app:layout_constraintStart_toStartOf="@id/thumbImage" />

    <TextView
        android:id="@+id/itemTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/thumbImage"
        app:layout_constraintEnd_toEndOf="@id/thumbImage"
        app:layout_constraintStart_toStartOf="@id/thumbImage" />

</androidx.constraintlayout.widget.ConstraintLayout>
